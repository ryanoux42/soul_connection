{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "script": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node ./bin/www",
    "server": "nodemon ./bin/www",
    "maj": "npm i && cd ../client && npm i",
    "client": "cd ../client && npm start",
    "prod": "node cron.js && npm start"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "cron": "^3.1.7",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "mysql": "^2.18.1",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pug": "2.0.0-beta11"
  },
  "devDependencies": {
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "connect-livereload": "^0.6.1",
    "css-loader": "^7.1.2",
    "livereload": "^0.9.3",
    "nodemon": "^3.1.4",
    "style-loader": "^4.0.0"
  }
}
